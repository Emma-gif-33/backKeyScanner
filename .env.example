# Database configuration
POSTGRES_USER=keyscanner_user
POSTGRES_PASSWORD=keyscanner_password
POSTGRES_DB=keyscanner_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Database connection strings
# Async connection (used by FastAPI with asyncpg)
DATABASE_URL=postgresql+asyncpg://keyscanner_user:keyscanner_password@localhost:5432/keyscanner_db
# Sync connection (used by Alembic migrations)
SYNC_DATABASE_URL=postgresql://keyscanner_user:keyscanner_password@localhost:5432/keyscanner_db

# Security & JWT
SECRET_KEY=secret_key_keyscanner_dev_only_change_in_production_min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
ENVIRONMENT=development
APP_NAME=KeyScanner
API_V1_STR=/api/v1
